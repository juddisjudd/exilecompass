{
  "name": "exilecompass",
  "version": "1.6.1",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:no-detect": "EXILECOMPASS_NO_DETECT=1 tauri dev",
    "build": "vite build",
    "dev:app": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "build:frontend": "vite build",
    "build:backend": "cargo build --manifest-path src-tauri/Cargo.toml --release",
    "build:release": "tauri build --no-bundle",
    "release": "tauri build",
    "release:tag": "node scripts/release.mjs",
    "preview": "vite preview",
    "paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
    "sync-guides": "node tools/sync-guides-fallback.mjs",
    "sync-regex": "bun tools/sync-regex-upstream.mjs",
    "voice-docs": "bun tools/build-voice-docs.mjs",
    "build:tree": "bun tools/build-poe1-tree.mjs",
    "build:poe1-regex-data": "bun tools/build-poe1-regex-data.mjs",
    "build:act-decoder-manifest": "bun tools/build-act-decoder-manifest.mjs",
    "addon:scaffold": "node tools/addon-scaffold/create-addon.mjs",
    "check": "bun run paraglide && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "bun run paraglide && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource/fira-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-global-shortcut": "~2.4.0",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.1"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.25.4",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^26.6.4",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.3",
    "vite": "^8.3.2",
    "yaml": "^2.9.1"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
